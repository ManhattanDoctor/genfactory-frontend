  {
    "reference": {
      "provider": "OPEN_AI_IMAGE_GPT",
      "model": "gpt-image-2"
    },
    "name": "gpt-image-2",
    "schema": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string",
          "const": "OPEN_AI_IMAGE_GPT"
        },
        "task": {
          "type": "object",
          "properties": {
            "session": {
              "type": "string"
            },
            "prompt": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32000
            },
            "fileIds": {
              "type": "array",
              "items": {
                "type": "integer",
                "exclusiveMinimum": 0
              },
              "maxItems": 16
            },
            "maskFileId": {
              "type": "integer",
              "exclusiveMinimum": 0
            }
          },
          "required": ["prompt"],
          "additionalProperties": false
        },
        "options": {
          "type": "object",
          "properties": {
            "model": {
              "type": "string",
              "enum": ["gpt-image-2"],
              "default": "gpt-image-2"
            },
            "size": {
              "type": "string",
              "pattern": "^(auto|[1-9][0-9]*x[1-9][0-9]*)$",
              "description": "auto or WIDTHxHEIGHT; custom sizes are supported by gpt-image-2",
              "default": "1024x1024"
            },
            "quality": {
              "type": "string",
              "enum": ["auto", "low", "medium", "high"],
              "default": "medium"
            },
            "background": {
              "type": "string",
              "enum": ["auto", "transparent", "opaque"],
              "default": "opaque"
            },
            "format": {
              "type": "string",
              "enum": ["png", "jpeg", "webp"]
            },
            "compression": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "moderation": {
              "type": "string",
              "enum": ["auto", "low"]
            },
            "stream": {
              "type": "boolean"
            },
            "partialImages": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3,
              "description": "Requires stream=true; only final images are saved"
            }
          },
          "additionalProperties": false,
          "default": {},
          "allOf": [
            {
              "if": {
                "required": ["compression"]
              },
              "then": {
                "required": ["format"],
                "properties": {
                  "format": {
                    "enum": ["jpeg", "webp"]
                  }
                }
              }
            },
            {
              "if": {
                "required": ["background"],
                "properties": {
                  "background": {
                    "const": "transparent"
                  }
                }
              },
              "then": {
                "properties": {
                  "format": {
                    "enum": ["png", "webp"]
                  }
                }
              }
            },
            {
              "if": {
                "required": ["partialImages"]
              },
              "then": {
                "required": ["stream"],
                "properties": {
                  "stream": {
                    "const": true
                  }
                }
              }
            }
          ]
        }
      },
      "required": ["model", "task"],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#",
      "allOf": [
        {
          "if": {
            "properties": {
              "task": {
                "required": ["maskFileId"]
              }
            }
          },
          "then": {
            "properties": {
              "task": {
                "required": ["fileIds"],
                "properties": {
                  "fileIds": {
                    "minItems": 1
                  }
                }
              }
            }
          }
        }
      ]
    },
    "capabilities": ["TEXT_INPUT", "IMAGE_INPUT", "IMAGE_OUTPUT", "IMAGE_EDIT"]
  },
