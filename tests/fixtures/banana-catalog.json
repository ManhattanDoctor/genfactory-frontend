            "size": {
              "type": "string",
              "pattern": "^(512|768|1K|1\\.5K|2K|4K|[1-9][0-9]*x[1-9][0-9]*)$"
            },
            "aspectRatio": {
              "type": "string",
              "description": "Model-supported aspect ratio, e.g. 16:9, 1:1, auto",
              "enum": ["1:1", "2:3", "3:2", "3:4", "4:3", "4:5", "5:4", "9:16", "16:9", "21:9"]
            },
            "format": {
              "type": "string",
              "enum": ["png", "jpeg", "webp", "svg"]
            },
            "provider": {
              "type": "object",
              "properties": {
                "only": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "order": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "ignore": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "sort": {
                  "type": "string",
                  "enum": ["price", "throughput", "latency"]
                },
                "allowFallbacks": {
                  "type": "boolean"
                },
                "options": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "object",
                    "additionalProperties": {}
                  },
                  "description": "Only keys listed in the selected endpoint allowed_passthrough_parameters"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false,
          "default": {},
          "allOf": [
            {
              "if": {
                "required": ["compression"]
              },
              "then": {
                "required": ["format"],
                "properties": {
                  "format": {
                    "enum": ["jpeg", "webp"]
                  }
                }
              }
            },
            {
              "if": {
                "required": ["background"],
                "properties": {
                  "background": {
                    "const": "transparent"
                  }
                }
              },
              "then": {
                "properties": {
                  "format": {
                    "enum": ["png", "webp"]
                  }
                }
              }
            }
          ]
        }
      },
      "required": ["model", "task"],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  }
]
