{
  "name": "genfactory-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc -b",
    "format": "prettier --write src tests *.ts *.json docs README.md",
    "format:check": "prettier --check src tests *.ts *.json docs README.md"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@tanstack/react-query": "^5.105.1",
    "ajv": "^8.20.0",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@playwright/test": "1.58",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "prettier": "^3.9.10",
    "typescript": "5.9",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
